# Line endings (NVG-5): text files are stored and checked out with LF, also on Windows.
* text=auto eol=lf

# cmd.exe needs CRLF in batch files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no line-ending conversion, no text diffs or merges.
